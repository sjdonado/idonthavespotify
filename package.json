{
  "name": "idonthavespotify",
  "version": "1.9.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel watch:assets watch:server",
    "watch:assets": "bun run build.config.ts --watch",
    "watch:server": "bun run --watch src/index.ts | bunx pino-pretty",
    "build": "bun run build.config.ts --minify",
    "build:prod": "bun build src/index.ts --compile --minify --sourcemap=linked --asset ./public --outfile ./dist/idonthavespotify",
    "build:workers": "bun build --tsconfig-override ./tsconfig.workers.json --target=browser --outfile ./dist/workers.js ./src/workers.ts",
    "test": "NODE_ENV=test bun test --isolate",
    "test:mocks:fetch": "bun run scripts/fetch-snapshots.ts",
    "test:ci": "bun run test:mocks:fetch && bun run build && NODE_ENV=test bun test --isolate",
    "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.workers.json"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "cheerio": "^1.2.0",
    "howler": "^2.2.4",
    "html-entities": "^2.6.0",
    "impit": "^0.13.1",
    "nano-jsx": "^0.2.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "string-similarity": "^4.0.4",
    "toastify-js": "^1.12.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "1.4.2",
    "@types/howler": "^2.2.13",
    "@types/string-similarity": "^4.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "domhandler": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx": "^0.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
